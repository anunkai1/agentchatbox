# agentchatbox configuration
#
# Chat-provider authentication is owned by pi's ~/.pi/agent/auth.json.
# This file contains only non-secret server settings and optional keys needed
# by transport-side voice or pi extensions.

# Server
PORT=3000
HOST=127.0.0.1
UPLOADS_DIR=./uploads
# One file (default 2 GiB) and aggregate storage (default 20 GiB).
MAX_UPLOAD_BYTES=2147483648
AGENTCHATBOX_MAX_UPLOAD_STORAGE_BYTES=21474836480
# Exact comma-separated browser origins allowed to open /api/chat.
AGENTCHATBOX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENTCHATBOX_MAX_WS_CONNECTIONS=16
AGENTCHATBOX_MAX_LIVE_SESSIONS=8
AGENTCHATBOX_WS_MAX_PAYLOAD_BYTES=41943040
# Cold/resumed pi children may need time to parse large sessions and initialise extensions.
AGENTCHATBOX_PI_READY_TIMEOUT_MS=30000

# pi subprocess — the server spawns `pi --mode rpc` per WS connection.
# PI_BIN defaults to "pi" (resolved via $PATH). Override only for tests.
# PI_CWD defaults to process.cwd() at boot. Override to scope pi's sessions.
#PI_BIN=pi
#PI_CWD=

# Voice / TTS / STT
# Python binary for faster-whisper (STT). Defaults to python3.
#PYTHON_BIN=python3
# TTS is always Kokoro via the pi-voice-server service (KOKORO_HOST/PORT/VOICE).
# Optional cheap model used by the bundled pi auto-title extension after the
# first successful answer. Format: provider/modelId. Unset = session model.
#AUTO_TITLE_MODEL=venice/deepseek-v4-flash-0731
# Override pi's session directory (where JSONL session files are stored).
# Defaults to ~/.pi/agent/sessions.
#PI_CODING_AGENT_SESSION_DIR=

# Optional provider keys used by voice/transcript/image/web extensions.
# These do NOT control the chat model picker; pi's auth.json does.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MINIMAX_API_KEY=
HF_TOKEN=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
AI_GATEWAY_API_KEY=
ZAI_API_KEY=
VENICE_API_KEY=
KIMI_API_KEY=
OPENCODE_API_KEY=

# OPENAI_API_KEY is also used for voice transcription (Whisper).
# If you only need chat, the same key is reused.

# Semantic session search — OPTIONAL, pluggable feature.
# When enabled, the sidebar gains a "search chats by meaning" box. It embeds
# every session's messages with a local model and matches by meaning, so you
# can find an old chat by describing it in your own words.
# Requires TWO optional packages installed separately (NOT pulled by default):
#   npm install better-sqlite3 @huggingface/transformers
# Set to 1 to enable. Leave unset/0 and the feature is invisible and the
# server runs identically to a plain install.
#AGENTCHATBOX_SEARCH_ENABLED=1
# Override the index DB location. Defaults to <projectRoot>/data/search.db.
#AGENTCHATBOX_SEARCH_DB=
